<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.studentmanagement.gui.StudentDashboardController" spacing="20">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Text fx:id="welcomeText" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Logout" onAction="#handleLogout" style="-fx-background-color: #f44336; -fx-text-fill: white;"/>
    </HBox>

    <TabPane>
        <Tab text="Profile">
            <ScrollPane fitToWidth="true">
                <VBox spacing="15">
                    <padding>
                        <Insets top="10" right="10" bottom="10" left="10"/>
                    </padding>
                    <GridPane vgap="10" hgap="10">
                        <Label text="Name:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <TextField fx:id="nameField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                        <Label text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <TextField fx:id="emailField" GridPane.columnIndex="1" GridPane.rowIndex="1" editable="false"/>

                        <Label text="Mobile Number:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                        <TextField fx:id="mobileField" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                        <Label text="Blood Group:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                        <TextField fx:id="bloodGroupField" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                        <Label text="Address:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                        <TextArea fx:id="addressArea" GridPane.columnIndex="1" GridPane.rowIndex="4" prefRowCount="3"/>

                        <Label text="Course:" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                        <TextField fx:id="courseField" GridPane.columnIndex="1" GridPane.rowIndex="5"/>

                        <Label text="Program:" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
                        <TextField fx:id="programField" GridPane.columnIndex="1" GridPane.rowIndex="6"/>

                        <Label text="Stream:" GridPane.columnIndex="0" GridPane.rowIndex="7"/>
                        <TextField fx:id="streamField" GridPane.columnIndex="1" GridPane.rowIndex="7"/>

                        <Label text="Hosteller:" GridPane.columnIndex="0" GridPane.rowIndex="8"/>
                        <CheckBox fx:id="hostellerCheckBox" GridPane.columnIndex="1" GridPane.rowIndex="8"/>
                    </GridPane>

                    <HBox spacing="10" alignment="CENTER_RIGHT">
                        <Button text="Update Profile" onAction="#handleUpdateProfile" style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
                    </HBox>
                </VBox>
            </ScrollPane>
        </Tab>

        <Tab text="Courses">
            <VBox spacing="10">
                <padding>
                    <Insets top="10" right="10" bottom="10" left="10"/>
                </padding>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button text="Add Course" onAction="#handleAddCourse" style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
                </HBox>

                <TableView fx:id="coursesTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="courseNameColumn" text="Course Name" prefWidth="300"/>
                        <TableColumn fx:id="courseActionsColumn" text="Actions" prefWidth="100"/>
                    </columns>
                </TableView>
            </VBox>
        </Tab>
    </TabPane>

    <Label fx:id="statusLabel" style="-fx-text-fill: #2196F3;"/>
</VBox> 