<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.studentmanagement.gui.AddStudentController" spacing="10">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Add New Student" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <GridPane vgap="10" hgap="10">
        <Label text="Username:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="usernameField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Password:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <PasswordField fx:id="passwordField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextField fx:id="emailField" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

        <Label text="Name:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <TextField fx:id="nameField" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

        <Label text="Mobile Number:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
        <TextField fx:id="mobileField" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

        <Label text="Blood Group:" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
        <TextField fx:id="bloodGroupField" GridPane.columnIndex="1" GridPane.rowIndex="5"/>

        <Label text="Address:" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
        <TextArea fx:id="addressArea" GridPane.columnIndex="1" GridPane.rowIndex="6" prefRowCount="3"/>

        <Label text="Course:" GridPane.columnIndex="0" GridPane.rowIndex="7"/>
        <TextField fx:id="courseField" GridPane.columnIndex="1" GridPane.rowIndex="7"/>

        <Label text="Program:" GridPane.columnIndex="0" GridPane.rowIndex="8"/>
        <TextField fx:id="programField" GridPane.columnIndex="1" GridPane.rowIndex="8"/>

        <Label text="Stream:" GridPane.columnIndex="0" GridPane.rowIndex="9"/>
        <TextField fx:id="streamField" GridPane.columnIndex="1" GridPane.rowIndex="9"/>

        <Label text="Hosteller:" GridPane.columnIndex="0" GridPane.rowIndex="10"/>
        <CheckBox fx:id="hostellerCheckBox" GridPane.columnIndex="1" GridPane.rowIndex="10"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancel" onAction="#handleCancel" style="-fx-background-color: #f44336; -fx-text-fill: white;"/>
        <Button text="Add Student" onAction="#handleAddStudent" style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
    </HBox>

    <Label fx:id="errorLabel" style="-fx-text-fill: red;"/>
</VBox> 